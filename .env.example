DEBUG=1
SECRET_KEY=replace-with-a-random-local-development-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
JOURNAL_ENCRYPTION_KEY=use-the-same-private-value-as-render
COACH_SERVICE_URL=http://127.0.0.1:8001
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:your-email@example.com
# Optional two-way sync. Set these only on the local machine; copy the same
# secret and JOURNAL_ENCRYPTION_KEY into Render's mam-wellbeing environment.
# DATABASE_SYNC_ENABLED=1
# DATABASE_SYNC_REMOTE_URL=https://your-mam-wellbeing-service.onrender.com
# DATABASE_SYNC_SHARED_SECRET=replace-with-a-long-random-shared-secret
# DATABASE_SYNC_INTERVAL_SECONDS=60
# Optional SMTP settings for actual email delivery. For Gmail, use an app password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
